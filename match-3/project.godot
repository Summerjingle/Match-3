; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Match-3"
run/main_scene="uid://c3tbx7cx0yevc"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=576
window/size/viewport_height=1024
window/size/window_width_override=288
window/size/window_height_override=512
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[input]

ui_touch={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(209, 18),"global_position":Vector2(218, 66),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
; 关闭像素对齐：开着会让旋转的节点出现锯齿（四角被咬合到整像素）
;2d/snap/snap_2d_transforms_to_pixel=true
;2d/snap/snap_2d_vertices_to_pixel=true
; 2D 4x MSAA：消除旋转边缘的斜边锯齿
rendering/anti_aliasing/quality/msaa_2d=2
